    "Sit somewhere quiet. Turn on noise cancellation if your headphones have it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt dig et stille sted. Slå støjreduktion til, hvis dine hovedtelefoner har det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzen Sie sich an einen ruhigen Ort. Schalten Sie die Geräuschunterdrückung ein, falls Ihr Kopfhörer sie hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siéntate en un lugar tranquilo. Activa la cancelación de ruido si tus auriculares la tienen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istu hiljaisessa paikassa. Laita vastamelu päälle, jos kuulokkeissasi on se."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez-vous dans un endroit calme. Activez la réduction de bruit si votre casque en dispose."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett deg et stille sted. Slå på støyreduksjon hvis hodetelefonene dine har det."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sätt dig någonstans där det är tyst. Slå på brusreducering om dina hörlurar har det."
          }
        }
      }
    },
