          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulostulo on mykistetty. Poista mykistys ja jatka sitten testiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
