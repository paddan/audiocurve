    "AudioCurve keeps processing what your Mac plays when its window is closed." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve fortsätter att behandla det din Mac spelar även när fönstret är stängt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve bliver ved med at behandle det, din Mac afspiller, når vinduet er lukket."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve fortsetter å behandle det Macen spiller av når vinduet er lukket."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve käsittelee Macin toistamaa ääntä myös ikkunan ollessa suljettuna."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve bearbeitet weiter, was dein Mac wiedergibt, auch wenn das Fenster geschlossen ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve continue de traiter ce que lit votre Mac lorsque sa fenêtre est fermée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve sigue procesando lo que reproduce tu Mac cuando su ventana está cerrada."
          }
        }
      }
    },
    "AudioCurve processes sound only while its window is open and Bypass is off. Closing the window quits AudioCurve." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve behandlar ljud bara när fönstret är öppet och Bypass är av. När du stänger fönstret avslutas AudioCurve."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve behandler kun lyd, mens vinduet er åbent og Bypass er slået fra. Når du lukker vinduet, afsluttes AudioCurve."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve behandler lyd bare mens vinduet er åpent og Bypass er av. Når du lukker vinduet, avsluttes AudioCurve."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve käsittelee ääntä vain, kun ikkuna on auki ja Bypass on pois päältä. Ikkunan sulkeminen lopettaa AudioCurven."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve bearbeitet den Ton nur, solange das Fenster offen und Bypass aus ist. Wenn du das Fenster schließt, wird AudioCurve beendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve ne traite le son que lorsque sa fenêtre est ouverte et que Bypass est désactivé. Fermer la fenêtre quitte AudioCurve."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve solo procesa el sonido mientras su ventana está abierta y Bypass está desactivado. Al cerrar la ventana, AudioCurve se cierra."
          }
        }
      }
    },
