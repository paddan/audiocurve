    "The output is muted. Unmute it to start the test." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udgangen er slået fra. Slå lyden til for at starte testen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ausgabe ist stummgeschaltet. Heben Sie die Stummschaltung auf, um den Test zu starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La salida está silenciada. Activa el sonido para iniciar la prueba."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulostulo on mykistetty. Poista mykistys aloittaaksesi testin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sortie est en sourdine. Réactivez le son pour lancer le test."
