    "The 1 kHz retest differed by %@ dB in the left ear — consider testing again." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gentestet ved 1 kHz afveg med %@ dB på venstre øre – overvej at teste igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der 1-kHz-Wiederholungstest wich am linken Ohr um %@ dB ab – testen Sie eventuell erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La repetición a 1 kHz difirió %@ dB en el oído izquierdo; considera repetir la prueba."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 kHz:n uusintamittaus erosi %@ dB vasemmassa korvassa – harkitse testin uusimista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nouveau test à 1 kHz a différé de %@ dB à l’oreille gauche – envisagez de refaire le test."
