    "After saving, play some audio and press Auto level to set the output level." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du har gemt, så afspil noget lyd og tryk på Auto-niveau for at indstille udgangsniveauet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielen Sie nach dem Sichern etwas Audio ab und drücken Sie „Auto-Pegel“, um den Ausgangspegel einzustellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de guardar, reproduce algo de audio y pulsa Nivel automático para ajustar el nivel de salida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennuksen jälkeen toista jotain ääntä ja paina Automaattitaso asettaaksesi lähtötason."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après l’enregistrement, lancez un peu d’audio et appuyez sur Niveau auto pour régler le niveau de sortie."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du har lagret, spill av litt lyd og trykk på Auto-nivå for å stille inn utgangsnivået."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spela upp lite ljud efter att du har sparat och tryck på Auto-nivå för att ställa in utnivån."
          }
        }
      }
    },
    "Allow AudioCurve to record system audio" : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt AudioCurve att spela in systemljud"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve erlauben, Systemaudio aufzunehmen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que AudioCurve grabe el audio del sistema"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez AudioCurve à enregistrer l’audio du système"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli AudioCurven tallentaa järjestelmän ääntä"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi AudioCurve tillatelse til å ta opp systemlyd"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv AudioCurve tilladelse til at optage systemlyd"
          }
        }
      }
    },
    "Another app is playing sound. Stop it before you start." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anden app afspiller lyd. Stop den, før du starter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere App spielt Ton ab. Beenden Sie die Wiedergabe, bevor Sie beginnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app está reproduciendo sonido. Detenla antes de empezar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toinen sovellus toistaa ääntä. Pysäytä se ennen aloittamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre app émet du son. Arrêtez-la avant de commencer."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annen app spiller av lyd. Stopp den før du starter."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annan app spelar upp ljud. Stoppa den innan du börjar."
          }
        }
      }
    },
    "Another app is playing sound. Stop it, then resume the test." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anden app afspiller lyd. Stop den, og fortsæt så testen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere App spielt Ton ab. Beenden Sie die Wiedergabe und setzen Sie dann den Test fort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app está reproduciendo sonido. Detenla y luego reanuda la prueba."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toinen sovellus toistaa ääntä. Pysäytä se ja jatka sitten testiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre app émet du son. Arrêtez-la, puis reprenez le test."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annen app spiller av lyd. Stopp den, og fortsett så testen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annan app spelar upp ljud. Stoppa den och fortsätt sedan testet."
          }
        }
      }
    },
    "AudioCurve cannot set the volume of this output, so the level may be off. Set the volume to max yourself before you start." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve kan ikke indstille lydstyrken på denne udgang, så niveauet kan være forkert. Sæt selv lydstyrken til maks., før du starter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve kann die Lautstärke dieser Ausgabe nicht einstellen, daher kann der Pegel abweichen. Stellen Sie die Lautstärke selbst auf Maximum, bevor Sie beginnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve no puede ajustar el volumen de esta salida, así que el nivel puede no ser exacto. Pon tú el volumen al máximo antes de empezar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve ei voi säätää tämän ulostulon äänenvoimakkuutta, joten taso voi olla väärä. Aseta äänenvoimakkuus itse maksimiin ennen aloittamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve ne peut pas régler le volume de cette sortie, le niveau peut donc être inexact. Réglez vous-même le volume au maximum avant de commencer."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve kan ikke stille volumet på denne utgangen, så nivået kan være feil. Sett volumet til maks selv før du starter."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve kan inte ställa in volymen på den här utgången, så nivån kan bli fel. Ställ själv volymen på max innan du börjar."
          }
        }
      }
    },
    "AudioCurve is also running in %@: the sound is processed twice." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve körs också i %@: ljudet bearbetas två gånger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve läuft auch in %@: Der Ton wird doppelt bearbeitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve también se está ejecutando en %@: el sonido se procesa dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve s’exécute aussi dans %@ : le son est traité deux fois."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve on käynnissä myös sovelluksessa %@: ääni käsitellään kahdesti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve kjører også i %@: lyden behandles to ganger."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve kører også i %@: lyden behandles to gange."
          }
        }
      }
    },
