          }
        }
      }
    },
    "The output runs at a low sample rate (for example a headset in call mode). Stop using its microphone and try again." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udgangen kører med en lav samplingfrekvens (for eksempel et headset i opkaldstilstand). Stop med at bruge dens mikrofon, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ausgabe läuft mit einer niedrigen Abtastrate (zum Beispiel ein Headset im Anrufmodus). Verwenden Sie ihr Mikrofon nicht mehr und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La salida funciona a una frecuencia de muestreo baja (por ejemplo, unos auriculares en modo llamada). Deja de usar su micrófono y vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulostulo toimii matalalla näytteenottotaajuudella (esimerkiksi kuulokemikrofoni puhelutilassa). Lopeta sen mikrofonin käyttö ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sortie fonctionne à une fréquence d’échantillonnage basse (par exemple un casque en mode appel). Arrêtez d’utiliser son micro et réessayez."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utgangen kjører med lav samplingsfrekvens (for eksempel et headset i samtalemodus). Slutt å bruke mikrofonen og prøv igjen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utgången körs med låg samplingsfrekvens (till exempel ett headset i samtalsläge). Sluta använda dess mikrofon och försök igen."
          }
        }
      }
    },
    "The profile could not be saved." : {
