    "AudioCurve is also running in %@: the sound is processed twice." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve körs också i %@: ljudet bearbetas två gånger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve läuft auch in %@: Der Ton wird doppelt bearbeitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve también se está ejecutando en %@: el sonido se procesa dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve s’exécute aussi dans %@ : le son est traité deux fois."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve on käynnissä myös sovelluksessa %@: ääni käsitellään kahdesti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve kjører også i %@: lyden behandles to ganger."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve kører også i %@: lyden behandles to gange."
          }
        }
