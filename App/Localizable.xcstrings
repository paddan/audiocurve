        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det sämre örat kan vara underskattat. En audionom kan mäta det med maskering."
          }
        }
      }
    },
    "Turn off any system-wide EQ or sound enhancer." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå enhver systemdækkende EQ eller lydforbedring fra."
