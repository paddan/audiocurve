    },
    "AudioCurve lives in the menu bar. You can change this later in its menu." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AudioCurve finns i menyraden. Du kan ändra detta senare i dess meny."
