          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utgången är ljudlös. Slå på ljudet för att starta testet."
          }
        }
      }
    },
    "The output is muted. Unmute it, then resume the test." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
