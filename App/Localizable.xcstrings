          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalten Sie systemweite EQs oder Klangverbesserer aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva cualquier ecualizador o mejora de sonido de todo el sistema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista käytöstä kaikki järjestelmänlaajuiset taajuuskorjaimet ja äänenparantajat."
