            "value": "Testen stoppede, fordi vinduet blev lukket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Test wurde beendet, weil das Fenster geschlossen wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba se detuvo porque se cerró la ventana."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Testi pysähtyi, koska ikkuna suljettiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le test s’est arrêté car la fenêtre a été fermée."
          }
        },
        "nb": {
