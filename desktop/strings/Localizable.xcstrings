    "No response at the maximum level at %@ Hz (left ear): the real threshold may be higher.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen reaktion ved maksimalt niveau ved %@ Hz (venstre øre): den reelle tærskel kan være højere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Reaktion bei maximalem Pegel bei %@ Hz (linkes Ohr): Die tatsächliche Schwelle kann höher liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin respuesta al nivel máximo a %@ Hz (oído izquierdo): el umbral real puede ser más alto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vastetta maksimitasolla taajuudella %@ Hz (vasen korva): todellinen kynnys voi olla korkeampi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune réponse au niveau maximal à %@ Hz (oreille gauche) : le seuil réel peut être plus élevé."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen respons på maksimalt nivå ved %@ Hz (venstre øre): den reelle terskelen kan være høyere."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget svar på högsta nivån vid %@ Hz (vänster öra): den verkliga tröskeln kan vara högre."
          }
        }
      }
    },
    "No response at the maximum level at %@ Hz (right ear): the real threshold may be higher.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen reaktion ved maksimalt niveau ved %@ Hz (højre øre): den reelle tærskel kan være højere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Reaktion bei maximalem Pegel bei %@ Hz (rechtes Ohr): Die tatsächliche Schwelle kann höher liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin respuesta al nivel máximo a %@ Hz (oído derecho): el umbral real puede ser más alto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vastetta maksimitasolla taajuudella %@ Hz (oikea korva): todellinen kynnys voi olla korkeampi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune réponse au niveau maximal à %@ Hz (oreille droite) : le seuil réel peut être plus élevé."
          }
        },
        "nb": {
