            "value": "AudioCurve päällä"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve på"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve til"
          }
        }
      }
    },
    "AudioCurve processes all sound in the background. You can change this later in Settings.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve behandlar allt ljud i bakgrunden. Du kan ändra detta senare i Inställningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve behandler al lyd i baggrunden. Du kan ændre dette senere i Indstillinger."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve behandler all lyd i bakgrunnen. Du kan endre dette senere i Innstillinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve käsittelee kaiken äänen taustalla. Voit muuttaa tätä myöhemmin asetuksissa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve bearbeitet den gesamten Ton im Hintergrund. Du kannst das später in den Einstellungen ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve traite tout le son en arrière-plan. Vous pourrez modifier ce choix plus tard dans les Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve procesa todo el sonido en segundo plano. Puedes cambiarlo más tarde en Ajustes."
          }
        }
      }
    },
    "AudioCurve processes sound only while its window is open and Bypass is off. Closing the window quits AudioCurve.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve behandlar ljud bara när fönstret är öppet och Bypass är av. När du stänger fönstret avslutas AudioCurve."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve behandler kun lyd, mens vinduet er åbent og Bypass er slået fra. Når du lukker vinduet, afsluttes AudioCurve."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve behandler lyd bare mens vinduet er åpent og Bypass er av. Når du lukker vinduet, avsluttes AudioCurve."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve käsittelee ääntä vain, kun ikkuna on auki ja Bypass on pois päältä. Ikkunan sulkeminen lopettaa AudioCurven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve bearbeitet den Ton nur, solange das Fenster offen und Bypass aus ist. Wenn du das Fenster schließt, wird AudioCurve beendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve ne traite le son que lorsque sa fenêtre est ouverte et que Bypass est désactivé. Fermer la fenêtre quitte AudioCurve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve solo procesa el sonido mientras su ventana está abierta y Bypass está desactivado. Al cerrar la ventana, AudioCurve se cierra."
          }
        }
      }
    },
    "AudioCurve processes the sound your Mac plays so it matches your hearing.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve behandlar ljudet som din Mac spelar så att det passar din hörsel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve behandler lyden, din Mac afspiller, så den passer til din hørelse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve behandler lyden Macen spiller av, slik at den passer til hørselen din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve käsittelee Macin toistamaa ääntä, jotta se sopii kuuloosi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve bearbeitet den Ton, den Ihr Mac wiedergibt, damit er zu Ihrem Gehör passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve traite le son que lit votre Mac pour l’adapter à votre audition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve procesa el sonido que reproduce tu Mac para que se adapte a tu audición."
          }
        }
      }
    },
