    "Turn off any system-wide EQ or sound enhancer.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå enhver systemdækkende EQ eller lydforbedring fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie systemweite EQs oder Klangverbesserer aus."
          }
