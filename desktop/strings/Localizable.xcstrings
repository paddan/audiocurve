    "The output is muted. Unmute it to start the test.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udgangen er slået fra. Slå lyden til for at starte testen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgabe ist stummgeschaltet. Heben Sie die Stummschaltung auf, um den Test zu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida está silenciada. Activa el sonido para iniciar la prueba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulostulo on mykistetty. Poista mykistys aloittaaksesi testin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie est en sourdine. Réactivez le son pour lancer le test."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utgangen er dempet. Slå på lyden for å starte testen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utgången är ljudlös. Slå på ljudet för att starta testet."
          }
        }
      }
    },
    "The output is muted. Unmute it, then resume the test.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udgangen er slået fra. Slå lyden til, og fortsæt så testen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgabe ist stummgeschaltet. Heben Sie die Stummschaltung auf und setzen Sie dann den Test fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida está silenciada. Activa el sonido y luego reanuda la prueba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulostulo on mykistetty. Poista mykistys ja jatka sitten testiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie est en sourdine. Réactivez le son, puis reprenez le test."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utgangen er dempet. Slå på lyden, og fortsett så testen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utgången är ljudlös. Slå på ljudet och fortsätt sedan testet."
          }
        }
      }
    },
    "The output runs at a low sample rate (for example a headset in call mode). Stop using its microphone and try again.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udgangen kører med en lav samplingfrekvens (for eksempel et headset i opkaldstilstand). Stop med at bruge dens mikrofon, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgabe läuft mit einer niedrigen Abtastrate (zum Beispiel ein Headset im Anrufmodus). Verwenden Sie ihr Mikrofon nicht mehr und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida funciona a una frecuencia de muestreo baja (por ejemplo, unos auriculares en modo llamada). Deja de usar su micrófono y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulostulo toimii matalalla näytteenottotaajuudella (esimerkiksi kuulokemikrofoni puhelutilassa). Lopeta sen mikrofonin käyttö ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie fonctionne à une fréquence d’échantillonnage basse (par exemple un casque en mode appel). Arrêtez d’utiliser son micro et réessayez."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utgangen kjører med lav samplingsfrekvens (for eksempel et headset i samtalemodus). Slutt å bruke mikrofonen og prøv igjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utgången körs med låg samplingsfrekvens (till exempel ett headset i samtalsläge). Sluta använda dess mikrofon och försök igen."
          }
        }
      }
    },
    "The profile could not be saved.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilen kunne ikke gemmes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil konnte nicht gesichert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el perfil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiilia ei voitu tallentaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil n’a pas pu être enregistré."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilen kunne ikke lagres."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilen kunde inte sparas."
          }
        }
      }
    },
    "The sound processing stopped": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudbehandlingen stoppade"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydbehandlingen stoppede"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydbehandlingen stoppet"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänenkäsittely pysähtyi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Klangverarbeitung wurde angehalten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le traitement du son s’est arrêté"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El procesamiento de sonido se detuvo"
          }
        }
      }
    },
    "The test controls the level itself. Turn the volume back down when it ends.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Testen styrer selv niveauet. Skru ned for lydstyrken igen, når den er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Test regelt den Pegel selbst. Drehen Sie die Lautstärke nach dem Test wieder herunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba controla el nivel por sí misma. Vuelve a bajar el volumen cuando termine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Testi säätää tasoa itse. Laske äänenvoimakkuus takaisin, kun testi päättyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le test contrôle lui-même le niveau. Baissez de nouveau le volume à la fin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Testen styrer nivået selv. Skru ned volumet igjen når den er ferdig."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Testet styr nivån själv. Sänk volymen igen när det är klart."
          }
        }
      }
    },
    "The test sets the headphone volume to max and controls the level itself. The volume is restored afterwards.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Testen sætter lydstyrken i hovedtelefonerne til maks. og styrer selv niveauet. Lydstyrken gendannes bagefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Test stellt die Kopfhörerlautstärke auf Maximum und regelt den Pegel selbst. Die Lautstärke wird danach wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba pone el volumen de los auriculares al máximo y controla el nivel por sí misma. Después se restablece el volumen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Testi asettaa kuulokkeiden äänenvoimakkuuden maksimiin ja säätää tasoa itse. Äänenvoimakkuus palautetaan lopuksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le test règle le volume du casque au maximum et contrôle lui-même le niveau. Le volume est rétabli ensuite."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Testen setter volumet i hodetelefonene til maks og styrer nivået selv. Volumet gjenopprettes etterpå."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Testet ställer hörlurarnas volym på max och styr nivån själv. Volymen återställs efteråt."
          }
        }
      }
    },
    "The test stopped because AudioCurve started in another app.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Testen stoppede, fordi AudioCurve blev startet i en anden app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Test wurde beendet, weil AudioCurve in einer anderen App gestartet wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba se detuvo porque AudioCurve se inició en otra app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Testi pysähtyi, koska AudioCurve käynnistyi toisessa sovelluksessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le test s’est arrêté car AudioCurve a démarré dans une autre app."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Testen stoppet fordi AudioCurve startet i en annen app."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Testet avbröts eftersom AudioCurve startade i en annan app."
          }
        }
      }
    },
    "The test stopped because the output changed.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Testen stoppede, fordi udgangen skiftede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Test wurde beendet, weil sich die Ausgabe geändert hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba se detuvo porque cambió la salida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Testi pysähtyi, koska ulostulo vaihtui."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le test s’est arrêté car la sortie a changé."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Testen stoppet fordi utgangen ble endret."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Testet avbröts eftersom utgången ändrades."
          }
        }
      }
    },
    "The test stopped because the output stopped playing.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Testen stoppede, fordi udgangen holdt op med at spille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Test wurde beendet, weil die Ausgabe die Wiedergabe gestoppt hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba se detuvo porque la salida dejó de reproducir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Testi pysähtyi, koska ulostulo lakkasi toistamasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le test s’est arrêté car la sortie a cessé de jouer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Testen stoppet fordi utgangen sluttet å spille."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Testet avbröts eftersom utgången slutade spela."
          }
        }
      }
    },
    "The test stopped because the output switched to a low sample rate.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Testen stoppede, fordi udgangen skiftede til en lav samplingfrekvens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Test wurde beendet, weil die Ausgabe auf eine niedrige Abtastrate umgeschaltet hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba se detuvo porque la salida cambió a una frecuencia de muestreo baja."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Testi pysähtyi, koska ulostulo vaihtui matalalle näytteenottotaajuudelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le test s’est arrêté, car la sortie est passée à une fréquence d’échantillonnage basse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Testen stoppet fordi utgangen byttet til lav samplingsfrekvens."
