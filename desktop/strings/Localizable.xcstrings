          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumet kunne ikke settes til maks, så testen startet ikke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Volymen kunde inte ställas på max, så testet startade inte."
          }
        }
      }
    },
    "The worse ear may be underestimated. An audiologist can measure it with masking.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det dårligste øre kan være undervurderet. En audiolog kan måle det med maskering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das schlechtere Ohr wird möglicherweise unterschätzt. Ein Audiologe kann es mit Vertäubung messen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El oído peor puede estar subestimado. Un audiólogo puede medirlo con enmascaramiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huonompi korva voi olla aliarvioitu. Audiologi voi mitata sen peittoäänen avulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’oreille la plus faible est peut-être sous-estimée. Un audiologiste peut la mesurer avec un masquage."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det dårligste øret kan være undervurdert. En audiograf kan måle det med maskering."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det sämre örat kan vara underskattat. En audionom kan mäta det med maskering."
          }
        }
      }
    },
