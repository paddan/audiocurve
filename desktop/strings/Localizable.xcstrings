            "value": "Testet avbröts eftersom fönstret stängdes."
          }
        }
      }
    },
    "The test tones could not be played on this output.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Testtonerne kunne ikke afspilles på denne udgang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Testtöne konnten auf dieser Ausgabe nicht abgespielt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron reproducir los tonos de prueba en esta salida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Testiääniä ei voitu toistaa tällä ulostulolla."
          }
        },
        "fr": {
