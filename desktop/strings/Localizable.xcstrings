            "state": "translated",
            "value": "Minst %lld punkter per øre"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minst %lld punkter per öra"
          }
        }
      }
    },
    "AudioCurve cannot set the volume of this output, so the level may be off. Set the volume to max yourself before you start.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve kan ikke indstille lydstyrken på denne udgang, så niveauet kan være forkert. Sæt selv lydstyrken til maks., før du starter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve kann die Lautstärke dieser Ausgabe nicht einstellen, daher kann der Pegel abweichen. Stellen Sie die Lautstärke selbst auf Maximum, bevor Sie beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve no puede ajustar el volumen de esta salida, así que el nivel puede no ser exacto. Pon tú el volumen al máximo antes de empezar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve ei voi säätää tämän ulostulon äänenvoimakkuutta, joten taso voi olla väärä. Aseta äänenvoimakkuus itse maksimiin ennen aloittamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve ne peut pas régler le volume de cette sortie, le niveau peut donc être inexact. Réglez vous-même le volume au maximum avant de commencer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve kan ikke stille volumet på denne utgangen, så nivået kan være feil. Sett volumet til maks selv før du starter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve kan inte ställa in volymen på den här utgången, så nivån kan bli fel. Ställ själv volymen på max innan du börjar."
          }
        }
      }
    },
    "AudioCurve is also running in %@: the sound is processed twice.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve körs också i %@: ljudet bearbetas två gånger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve läuft auch in %@: Der Ton wird doppelt bearbeitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve también se está ejecutando en %@: el sonido se procesa dos veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve s’exécute aussi dans %@ : le son est traité deux fois."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve on käynnissä myös sovelluksessa %@: ääni käsitellään kahdesti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve kjører også i %@: lyden behandles to ganger."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve kører også i %@: lyden behandles to gange."
          }
        }
      }
    },
    "AudioCurve is running in %@. Quit it to start the test.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve kører i %@. Afslut det for at starte testen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve läuft in %@. Beenden Sie es, um den Test zu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve se está ejecutando en %@. Ciérralo para iniciar la prueba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve on käynnissä sovelluksessa %@. Lopeta se aloittaaksesi testin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve est actif dans %@. Quittez cette app pour lancer le test."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve kjører i %@. Avslutt det for å starte testen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve körs i %@. Avsluta det för att starta testet."
          }
        }
      }
    },
    "AudioCurve keeps processing what your Mac plays when its window is closed.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve fortsätter att behandla det din Mac spelar även när fönstret är stängt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve bliver ved med at behandle det, din Mac afspiller, når vinduet er lukket."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve fortsetter å behandle det Macen spiller av når vinduet er lukket."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve käsittelee Macin toistamaa ääntä myös ikkunan ollessa suljettuna."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve bearbeitet weiter, was dein Mac wiedergibt, auch wenn das Fenster geschlossen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve continue de traiter ce que lit votre Mac lorsque sa fenêtre est fermée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve sigue procesando lo que reproduce tu Mac cuando su ventana está cerrada."
          }
        }
      }
    },
    "AudioCurve on": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve på"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve an"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve activado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AudioCurve activé"
          }
        },
        "fi": {
          "stringUnit": {
