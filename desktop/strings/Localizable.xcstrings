    },
    "The volume could not be set to max, so the test did not start.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lydstyrken kunne ikke sættes til maks., så testen startede ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lautstärke konnte nicht auf Maximum gestellt werden, daher wurde der Test nicht gestartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo poner el volumen al máximo, así que la prueba no se inició."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänenvoimakkuutta ei voitu asettaa maksimiin, joten testi ei alkanut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
