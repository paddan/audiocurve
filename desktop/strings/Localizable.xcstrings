            "value": "Slå Forstyr ikke til, så notifikationer ikke afspilles under testen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie „Nicht stören“, damit während des Tests keine Hinweistöne abgespielt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa No molestar para que no suenen avisos durante la prueba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita Älä häiritse -tila päälle, jotta ilmoitusäänet eivät soi testin aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Ne pas déranger pour qu’aucune alerte ne retentisse pendant le test."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Ikke forstyrr, så varsler ikke spilles av under testen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Stör ej så att aviseringar inte låter under testet."
          }
        }
      }
    },
    "Turn the volume back down now.": {
