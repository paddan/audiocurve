          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur mycket limitern sänker ljudet just nu. Ligger den ofta över några dB: sänk Utnivå och höj volymen på datorn i stället."
          }
        }
      }
    },
