    "Choose the output devices AudioCurve processes sound for. On other outputs the sound passes through unchanged." : {
      "comment" : "Help text for the active-outputs menu",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg de udgange, AudioCurve skal behandle lyd for. På andre udgange passerer lyden uændret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle die Ausgabegeräte, für die AudioCurve den Klang bearbeitet. Auf anderen Ausgängen bleibt der Klang unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige las salidas en las que AudioCurve procesa el sonido. En otras salidas el sonido pasa sin cambios."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse lähtölaitteet, joille AudioCurve käsittelee äänen. Muissa lähdöissä ääni kulkee muuttumattomana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les sorties pour lesquelles AudioCurve traite le son. Sur les autres sorties, le son passe sans modification."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg utgangene AudioCurve skal behandle lyd for. På andre utganger går lyden uendret gjennom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj de utgångar AudioCurve ska behandla ljud för. På andra utgångar går ljudet igenom oförändrat."
          }
        }
      }
    },
