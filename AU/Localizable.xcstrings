    "Lowers or raises the sound before it is amplified. A lower input level makes the compression work less." : {
      "comment" : "Help text for the input level slider",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sænker eller hæver lyden, før den forstærkes. Et lavere indgangsniveau får kompressionen til at arbejde mindre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senkt oder hebt den Pegel, bevor er verstärkt wird. Ein niedrigerer Eingangspegel lässt die Kompression weniger arbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja o sube el sonido antes de amplificarlo. Un nivel de entrada más bajo hace que la compresión trabaje menos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laskee tai nostaa ääntä ennen vahvistusta. Matalampi tulotaso saa kompression toimimaan vähemmän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baisse ou monte le son avant l’amplification. Un niveau d’entrée plus bas fait moins travailler la compression."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senker eller hever lyden før den forsterkes. Lavere inngangsnivå gjør at kompresjonen jobber mindre."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sänker eller höjer ljudet innan det förstärks. Lägre innivå gör att kompressionen arbetar mindre."
          }
        }
      }
    },
